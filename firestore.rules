rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@magaxia.com' ||
        request.auth.token.email == 'adm@magaxia.com'
      );
    }

    // ══════════════════════════════════════════════════════════════════
    // COLEÇÕES EXISTENTES — inalteradas
    // ══════════════════════════════════════════════════════════════════

    // vip5_codigos — geração e ativação de códigos VIP
    match /vip5_codigos/{codeId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        request.auth != null &&
        resource.data.usado != true &&
        request.resource.data.usado == true &&
        request.resource.data.usadoPor == request.auth.uid &&
        request.resource.data.status == 'usado' &&
        request.resource.data.activatedBy == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // users — dados de usuário e campos vip5Active, vip5ExpiresAt, vip5Code
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // ══════════════════════════════════════════════════════════════════
    // COLEÇÕES NOVAS — módulo vip5-promocoes-storage.js
    // ══════════════════════════════════════════════════════════════════

    // vip5_promocoes — promoções criadas pelo admin
    match /vip5_promocoes/{promoId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // vip5_promocoes_participantes — participações dos usuários
    match /vip5_promocoes_participantes/{partId} {
      allow read: if request.auth != null
        && (resource == null || resource.data.uid == request.auth.uid || isAdmin());

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      allow update: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin())
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isAdmin();
    }

    // vip5_promocoes_logs — auditoria de ações do módulo de promoções
    match /vip5_promocoes_logs/{logId} {
      // Qualquer usuário autenticado pode CRIAR logs
      // (registerParticipation e ações admin criam logs)
      allow create: if request.auth != null;

      // Somente admin pode LER logs
      allow read: if request.auth != null;
      // Para produção: && request.auth.token.admin == true

      // Ninguém edita ou exclui logs
      allow update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════
    // COLEÇÕES NOVAS — módulo vip5-sorteios-storage.js
    // Regras adicionadas abaixo seguem o mesmo padrão das coleções existentes.
    // ══════════════════════════════════════════════════════════════════

    // vip5_sorteios — sorteios criados pelo admin
    match /vip5_sorteios/{sorteioId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // vip5_sorteios/{sorteioId}/vip5_sorteios_participantes — subcoleção de participantes do sorteio
    match /vip5_sorteios/{sorteioId}/vip5_sorteios_participantes/{participantId} {
      allow read: if request.auth != null
        && (resource == null || resource.data.uid == request.auth.uid || isAdmin());

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      allow update: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin())
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isAdmin();
    }

    // vip5_sorteios_resultados — resultados públicos/administrativos dos sorteios
    match /vip5_sorteios_resultados/{resultadoId} {
      // Qualquer usuário autenticado pode CRIAR resultados (sistemas/daemons)
      allow create: if request.auth != null;

      // Leitura liberada para usuários autenticados (ajuste para admin em produção se necessário)
      allow read: if request.auth != null;

      // Ninguém edita ou exclui resultados
      allow update, delete: if false;
    }

    // vip5_sorteios_logs — logs/auditoria do módulo de sorteios
    match /vip5_sorteios_logs/{logId} {
      // Qualquer usuário autenticado pode CRIAR logs
      allow create: if request.auth != null;

      // Somente admin pode LER logs
      allow read: if request.auth != null;
      // Para produção: && request.auth.token.admin == true

      // Ninguém edita ou exclui logs
      allow update, delete: if false;
    }

    // vip5_promocoes_usos — contagem de usos por usuário por promoção
    match /vip5_promocoes_usos/{useId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // compras — registro de compras e vendas do fluxo de produtos
    match /compras/{compraId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // depositos — movimentações financeiras
    match /depositos/{depositoId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // saques — solicitações de saque
    match /saques/{saqueId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // notificacoes — notificações de risco e auditoria
    match /notificacoes/{notificacaoId} {
      allow read: if request.auth != null && (resource.data.uidUsuario == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // auditoria_antifraude — registros de auditoria antifraude
    match /auditoria_antifraude/{auditId} {
      allow read: if request.auth != null && (resource.data.uidUsuario == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // produtos — catálogo de produtos
    match /produtos/{produtoId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // produtos_antecipados — catálogo de produtos antecipados
    match /produtos_antecipados/{produtoId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
