# Exemplo de variáveis de ambiente para backend seguro
PORT=9001
NODE_ENV=development
SESSION_SECRET=uma_chave_secreta_alta_64_chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@1234
ADMIN_2FA_ENABLED=true
ADMIN_2FA_SECRET=123456

# Configuração Firebase para frontend e validação local
FIREBASE_ENV=dev
FIREBASE_PROJECT_ID=meu-projeto-dev
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# As credenciais do Admin SDK não devem ser usadas no repositório.
# Não use serviceAccountKey.json no código.
